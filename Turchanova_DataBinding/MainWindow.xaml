<Window x:Class="Turchanova_DataBinding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Turchanova_DataBinding"
        mc:Ignorable="d"
        Title="My Services" Height="500" Width="400"
      >
    <DockPanel Margin="5 5 5 5" Background="#A3B5B4">

        <Border DockPanel.Dock="Top" Background="#074040" Padding="10">
            <TextBlock Text="Мои услуги" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Margin="0 10 0 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width ="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="ID" Margin="10" FontSize="14" HorizontalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Height="25" Width="180" IsReadOnly="True" HorizontalAlignment="Left" Text="{Binding Id, Mode=OneWay}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Название услуги" Margin="10" FontSize="14" HorizontalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Height="25" Width="180"  HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Исполнитель" Margin="10" FontSize="14" HorizontalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Height="25" Width="180"  HorizontalAlignment="Left" Text="{Binding Executor, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Стоимость часа" Margin="10" FontSize="14"  HorizontalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Height="25"  Width="180" HorizontalAlignment="Left" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Кол-во часов" Margin="10" FontSize="14" HorizontalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" Height="25" Width="180" HorizontalAlignment="Left" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Итоговая стоимость" Margin="10" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Height="25" Width="180" HorizontalAlignment="Left" FontSize="14" Text="{Binding ServiceCoast}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="Save" Content="Сохранить" Width="150" Height="30" Click="Save_Click"/>
                <Button x:Name="New" Content="Новая запись" Width="150" Height="30" Click="New_Click" Margin="10"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height ="Auto"/>
                    <RowDefinition Height ="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Text="Поиск по ID" Margin="10" FontSize="14" HorizontalAlignment="Center"/>
                <TextBox x:Name="FindId" Grid.Column="1" Height="25" Width="180" HorizontalAlignment="Left"/>
                <Button Grid.Row="1" Grid.ColumnSpan="2" x:Name="Find" Content="Найти по ID" Width="150" Height="30" HorizontalAlignment="Center" Margin="10" Click="Find_Click"/>
            </Grid>

            <TextBlock x:Name="Message" FontSize="14" HorizontalAlignment="Center"/>

        </StackPanel>




    </DockPanel>
</Window>
